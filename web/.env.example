# Base URL of the deployed PawConnect API, no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:3002

# Google Maps JavaScript API key (Maps + Places); restrict it to your deployed domain
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Public URL of this site, used for canonical links, the sitemap and social previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000
