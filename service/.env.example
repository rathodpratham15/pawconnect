# Required - PostgreSQL connection string (Neon: copy the "pooled connection" string)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
JWT_SECRET=change-me-to-a-long-random-string

# Optional
PORT=3002
# Comma-separated list of allowed frontend origins ("*" allows any)
CORS_ORIGIN=http://localhost:3000
# If both are set, an ADMIN account is created/updated on startup
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Only for `npm run import:ngos` (real NGOs from Every.org); never needed by the running API
EVERY_ORG_API_KEY=
